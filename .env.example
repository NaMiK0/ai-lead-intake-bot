# Скопируй этот файл в .env и подставь свои значения.
# .env добавлен в .gitignore — не коммить его.
#
# Значения со спецсимволами шелла (например `&` в строке подключения Neon —
# `?sslmode=require&channel_binding=require`) бери В КАВЫЧКАХ: локальный
# запуск грузит .env через `source .env` (см. README), и незаквоченный `&`
# прочитается как фон-процесс, а не часть значения.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-telegram-bot-token

# Ключ с https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# Postgres. Локально — поднимается через `docker compose up -d postgres`
# (см. docker-compose.yml), значения ниже совпадают с ним по умолчанию.
# В проде — строка подключения от managed-провайдера (например Neon).
DATABASE_URL=postgresql://lead_bot:lead_bot@localhost:5432/lead_bot

# Рубильник RAG-контура целиком. По умолчанию включён. На бесплатном тарифе
# Render выключен (модель эмбеддингов при загрузке реально занимает ~600 МБ
# RAM — не влезает в лимит 512 МБ, см. render.yaml) — бот работает без
# похожих заявок в контексте, остальной функционал не затронут.
RAG_ENABLED=true

# Qdrant (RAG — похожие прошлые заявки). Локально — поднимается через
# `docker compose up -d qdrant`, значение ниже подходит по умолчанию.
# В проде — Qdrant Cloud. QDRANT_API_KEY нужен только для облака, для
# локального Qdrant без auth — оставь пустым. Не нужны, если RAG_ENABLED=false.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Режим запуска: "polling" (по умолчанию, локально) или "webhook" (прод,
# Render). Следующие три переменные нужны ТОЛЬКО для BOT_MODE=webhook.
BOT_MODE=polling

# Публичный базовый URL сервиса, без пути и без слэша на конце
# (например https://lead-bot.onrender.com). На Render можно оставить
# пустым — берётся автоматически из RENDER_EXTERNAL_URL; для любого
# другого хостинга задать явно.
WEBHOOK_URL=

# Случайная строка — секрет, которым Telegram подписывает каждый
# webhook-запрос (заголовок X-Telegram-Bot-Api-Secret-Token), aiogram
# проверяет сам. Сгенерировать: `openssl rand -hex 32`.
WEBHOOK_SECRET=

# Порт aiohttp-сервера в режиме webhook. На Render передаётся автоматически
# через $PORT — здесь не обязателен, дефолт (8080) только для локальной
# ручной проверки webhook-режима.
PORT=8080
