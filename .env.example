# Скопируй этот файл в .env и подставь свои значения.
# .env добавлен в .gitignore — не коммить его.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-telegram-bot-token

# Ключ с https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# Postgres. Локально — поднимается через `docker compose up -d postgres`
# (см. docker-compose.yml), значения ниже совпадают с ним по умолчанию.
# В проде — строка подключения от managed-провайдера (например Neon).
DATABASE_URL=postgresql://lead_bot:lead_bot@localhost:5432/lead_bot

# Qdrant (RAG — похожие прошлые заявки). Локально — поднимается через
# `docker compose up -d qdrant`, значение ниже подходит по умолчанию.
# В проде — Qdrant Cloud (ещё не подключено). QDRANT_API_KEY нужен только
# для облака, для локального Qdrant без auth — оставь пустым.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
